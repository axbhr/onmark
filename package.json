{
  "name": "onmark",
  "displayName": "Onmark",
  "description": "Markdown that renders as you write. Live preview editing for Markdown in VS Code, with syntax that appears only where your cursor is.",
  "version": "0.0.0",
  "publisher": "axbhr",
  "author": "axbhr",
  "license": "GPL-3.0-or-later",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#F3EEE4",
    "theme": "light"
  },
  "homepage": "https://github.com/axbhr/onmark#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/axbhr/onmark.git"
  },
  "bugs": {
    "url": "https://github.com/axbhr/onmark/issues"
  },
  "qna": "https://github.com/axbhr/onmark/discussions",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "live preview",
    "wysiwyg",
    "editor",
    "codemirror",
    "obsidian",
    "notes",
    "writing",
    "callouts",
    "md"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "onmark.editor",
        "displayName": "Onmark Live Preview",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "onmark.openSource",
        "title": "Open as Source Text",
        "category": "Onmark",
        "icon": "$(go-to-file)"
      },
      {
        "command": "onmark.openPreview",
        "title": "Open in Live Preview",
        "category": "Onmark",
        "icon": {
          "light": "media/editor-title-light.svg",
          "dark": "media/editor-title-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "onmark.openSource",
          "when": "activeCustomEditorId == onmark.editor",
          "group": "navigation"
        },
        {
          "command": "onmark.openPreview",
          "when": "resourceLangId == markdown && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "onmark.openSource",
          "when": "activeCustomEditorId == onmark.editor"
        },
        {
          "command": "onmark.openPreview",
          "when": "resourceLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Onmark",
      "properties": {
        "onmark.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "Font family for body text. Empty uses the VS Code UI font."
        },
        "onmark.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 8,
          "description": "Font size of body text in pixels."
        },
        "onmark.readableLineLength": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Center the content and limit its width to `#onmark.maxWidth#`."
        },
        "onmark.maxWidth": {
          "type": "number",
          "default": 750,
          "minimum": 200,
          "markdownDescription": "Maximum content width in pixels when `#onmark.readableLineLength#` is enabled."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sample:large": "node scripts/large-sample.mjs",
    "vsix": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run package",
    "notices": "node scripts/notices.mjs",
    "smoke": "node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  }
}
